.ELEC: @STD::Import { .org &= "atopile"; .project &= "electronics" }
.PWR: @STD::Import { .uri &= "power.ato" }
.AUDIOCHANNEL: @STD::Import { .uri &= "circuits/AudioChannel.ato" }
.CODEC: @STD::Import { .uri &= "circuits/Codec.ato" }
.CONTROL: @STD::Import { .uri &= "circuits/Control.ato" }
.DSP: @STD::Import { .uri &= "circuits/Dsp.ato" }
.ETHERNETPORTS: @STD::Import { .uri &= "circuits/EthernetPorts.ato" }
.ETHERNETSWITCH: @STD::Import { .uri &= "circuits/EthernetSwitch.ato" }
.HOST: @STD::Import { .uri &= "circuits/Host.ato" }
.PANEL: @STD::Import { .uri &= "circuits/Panel.ato" }
.USB: @STD::Import { .uri &= "circuits/Usb.ato" }

.DspBoard: @type {
    /// DSP v1 circuit and routed placement, with the completed external-5V supply.
    .jlc_stackup: ELEC::JLCPCB::JLC041612_3313
    @trait(_): ELEC::PCB::is_pcb
    .power: PWR::PowerSupply

    .control: CONTROL::Control
    .dsp: DSP::Dsp
    .ethernet_ports: ETHERNETPORTS::EthernetPorts
    .host: HOST::Host
    .panel: PANEL::Panel
    .usb: USB::Usb
    .line_drivers: [14]AUDIOCHANNEL::AudioChannel
    .codecs: [2]CODEC::Codec
    .switches: [3]ETHERNETSWITCH::EthernetSwitch

    # Preserve the v1 net names and inter-block connections.
    @trait(_, .panel.net_xlr_audio_output_connectors_1_1): ELEC::has_net_name { .name &= "xlr_audio_output_connectors[1]-dmx-GND" }
    @trait(_, .panel.net_xlr_audio_output_connectors_2_1): ELEC::has_net_name { .name &= "xlr_audio_output_connectors[2]-dmx-GND" }
    @trait(_, .panel.net_xlr_audio_output_connectors_4_1): ELEC::has_net_name { .name &= "xlr_audio_output_connectors[4]-dmx-GND" }
    @trait(_, .panel.net_xlr_audio_output_connectors_0_1): ELEC::has_net_name { .name &= "xlr_audio_output_connectors[0]-dmx-GND" }
    @trait(_, .panel.net_xlr_audio_output_connectors_5_1): ELEC::has_net_name { .name &= "xlr_audio_output_connectors[5]-dmx-GND" }
    @trait(_, .panel.net_xlr_audio_output_connectors_3_1): ELEC::has_net_name { .name &= "xlr_audio_output_connectors[3]-dmx-GND" }
    @trait(_, .ethernet_ports.net_ic_55): ELEC::has_net_name { .name &= "switches[0]-ethernets[4]-ETH_P3_P" }
    @trait(_, .switches[2].net_ic_RXIN0): ELEC::has_net_name { .name &= "switches[2]-ethernets[0]-ETH_P0_N" }
    .ethernet_ports.net_ic_61 ~ .switches[0].net_ic_RXIP2
    @trait(_, .ethernet_ports.net_ic_61): ELEC::has_net_name { .name &= "switches[0]-ethernets[2]-ETH_P0_P" }
    @trait(_, .ethernet_ports.net_led_activity_resistors_2_1): ELEC::has_net_name { .name &= "switches[1]-ethernets[3]-ETH_LED_SPEED" }
    .ethernet_ports.net_ic_3 ~ .switches[0].net_ic_TXOP3
    @trait(_, .ethernet_ports.net_ic_3): ELEC::has_net_name { .name &= "switches[0]-ethernets[3]-ETH_P1_P" }
