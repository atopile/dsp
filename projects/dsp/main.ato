.ELEC: @STD::Import { .project &= "electronics"; .org &= "atopile" }
.PARTS := .ELEC::PARTS
.PWR:  @STD::Import { .uri &= "power.ato" }
.VCM:  @STD::Import { .uri &= "vendor/rpi-cm5/rpi-cm5.ato" }
.VDSP: @STD::Import { .uri &= "vendor/adi-adau145x/adi-adau145x.ato" }
.VCOD: @STD::Import { .uri &= "vendor/adi-ad1938/adi-ad1938.ato" }
.VSW:  @STD::Import { .uri &= "vendor/realtek-rtl8305nb/realtek-rtl8305nb.ato" }
.VRS:  @STD::Import { .uri &= "vendor/maxlinear-sp3485/maxlinear-sp3485.ato" }
.VDRV: @STD::Import { .uri &= "vendor/ti-drv135/ti-drv135.ato" }

.PANEL: @STD::Import { .uri &= "vendor/panel-connectors/panel-connectors.ato" }

.DspBoard: @type {
    /// Networked audio DSP: a compute module drives an ADAU1452 SigmaDSP
    /// and two AD1938 codecs, with fourteen balanced audio outputs, three
    /// RTL8305NB Ethernet switches, and SP3485-driven DMX512 I/O — modeled on
    /// atopile's public DSP design.
    .jlc_stackup: ELEC::JLCPCB::JLC041612_3313
    @trait(_): ELEC::PCB::is_pcb

    # --- Subsystems ---
    .power: PWR::PowerSupply
    .cm: VCM::RPI_CM5
    .dsp: VDSP::ADI_ADAU145x
    .codecs: [2]VCOD::Analog_Devices_AD1938
    .eth_switches: [3]VSW::Realtek_RTL8305NB
    .dmx_phy: VRS::MaxLinear_SP3485

    # --- Power distribution ---
    .power.power_5v ~ .cm.power_5v
    .power.power_3v3d ~ .dsp.power
    @for(.eth_switches, { power.power_3v3d ~ .obj.power_3v3 })
    .power.power_3v3d ~ .dmx_phy.power
    @for(.codecs, {
        power.power_3v3a ~ .obj.power
        power.power_3v3a ~ .obj.power_analog
    })

    # --- Control plane ---
    # CM -> DSP: register access over I2C, with pull-ups on the bus
    .cm.i2cs[0] ~ .dsp.i2c
    .i2c_pullups: [2]ELEC::Stuff::Resistor
    @for(.i2c_pullups, {
        .pullup := .obj
        .pullup.resistance &= 2.2kohm +/- 1%
    })
    @trait(_, .i2c_pullups[0]): PARTS::has_package_requirements { .size &= "0402" }
    @trait(_, .i2c_pullups[1]): PARTS::has_package_requirements { .size &= "0402" }
    .cm.i2cs[0].scl.line ~> .i2c_pullups[0] ~> .power.power_3v3d.hv
    .cm.i2cs[0].sda.line ~> .i2c_pullups[1] ~> .power.power_3v3d.hv

    # CM -> codec: register access over SPI
    @for(.codecs, { cm.spis[0] ~ .obj.spi })
    .cm.spi0_cs[0] ~ .codecs[0].spi_cs
    .cm.spi0_cs[1] ~ .codecs[1].spi_cs

    # Resets and strapping
    .cm.gpios[0] ~ .dsp.reset_disable
    @for(.codecs, { cm.gpios[1] ~ .obj.reset_disable })
    @for(.eth_switches, { cm.gpios[2] ~ .obj.reset })
    .dsp.selfboot_enable.line ~ .power.power_3v3d.lv  # boot from host, not flash

    # --- Audio path ---
    # CM <-> DSP: playback down, capture back (serial port 0)
    .cm.i2s_output ~ .dsp.i2s_ins[0]
    .dsp.i2s_outs[0] ~ .cm.i2s_input

    # DSP CLKOUT provides the codec master clock
    @for(.codecs, { dsp.pll_clock_out ~ .obj.pll_clock_in })

    # DSP -> codec: series-damped I2S lines across the digital/analog split
    .i2s_series_resistors: [6]ELEC::Stuff::Resistor
    @for(.i2s_series_resistors, {
        .damper := .obj
        .damper.resistance &= 10ohm +/- 5%
    })
    @trait(_, .i2s_series_resistors[0]): PARTS::has_package_requirements { .size &= "0402" }
    @trait(_, .i2s_series_resistors[1]): PARTS::has_package_requirements { .size &= "0402" }
    @trait(_, .i2s_series_resistors[2]): PARTS::has_package_requirements { .size &= "0402" }
    @trait(_, .i2s_series_resistors[3]): PARTS::has_package_requirements { .size &= "0402" }
    @trait(_, .i2s_series_resistors[4]): PARTS::has_package_requirements { .size &= "0402" }
    @trait(_, .i2s_series_resistors[5]): PARTS::has_package_requirements { .size &= "0402" }
    .dsp.i2s_outs[1].sck.line ~> .i2s_series_resistors[0] ~> .codecs[0].i2s_in.sck.line
    .dsp.i2s_outs[1].ws.line ~> .i2s_series_resistors[1] ~> .codecs[0].i2s_in.ws.line
    .dsp.i2s_outs[1].sd.line ~> .i2s_series_resistors[2] ~> .codecs[0].i2s_in.sd.line
    .dsp.i2s_outs[2].sck.line ~> .i2s_series_resistors[3] ~> .codecs[1].i2s_in.sck.line
    .dsp.i2s_outs[2].ws.line ~> .i2s_series_resistors[4] ~> .codecs[1].i2s_in.ws.line
    .dsp.i2s_outs[2].sd.line ~> .i2s_series_resistors[5] ~> .codecs[1].i2s_in.sd.line
    .codecs[0].i2s_out ~ .dsp.i2s_ins[1]

    # Balanced XLR inputs -> DC-blocked ADC inputs
    .xlr_in: [2]PANEL::AudioInput
    .input_dc_block_caps: [4]ELEC::Stuff::Capacitor
    @for(.input_dc_block_caps, {
        .blocker := .obj
        .blocker.capacitance &= 10uF +/- 20%
    })
    @trait(_, .input_dc_block_caps[0]): PARTS::has_package_requirements { .size &= "0805" }
    @trait(_, .input_dc_block_caps[1]): PARTS::has_package_requirements { .size &= "0805" }
    @trait(_, .input_dc_block_caps[2]): PARTS::has_package_requirements { .size &= "0805" }
    @trait(_, .input_dc_block_caps[3]): PARTS::has_package_requirements { .size &= "0805" }
    .xlr_in[0].signal.p.line ~> .input_dc_block_caps[0] ~> .codecs[0].adc_in[0].p.line
    .xlr_in[0].signal.n.line ~> .input_dc_block_caps[1] ~> .codecs[0].adc_in[0].n.line
    .xlr_in[1].signal.p.line ~> .input_dc_block_caps[2] ~> .codecs[0].adc_in[1].p.line
    .xlr_in[1].signal.n.line ~> .input_dc_block_caps[3] ~> .codecs[0].adc_in[1].n.line

    # Fourteen analog outputs: six XLR and two four-channel EtherCON ports.
    .line_drivers: [14]VDRV::TI_DRV135
    .xlr_out: [6]PANEL::AudioOutput
    .ethercon_out: [2]PANEL::EtherConAudioOutput
    @for(.line_drivers, { .obj.output_force ~ .obj.output_sense })
    .power.audio_banks[0].positive.power_out ~ .line_drivers[0].positive_power
    .power.audio_banks[0].negative.power_out ~ .line_drivers[0].negative_power
    .codecs[0].dac_out[0] ~ .line_drivers[0].input_signal
    .line_drivers[0].output_force ~ .xlr_out[0].signal
    .power.audio_banks[0].positive.power_out ~ .line_drivers[1].positive_power
    .power.audio_banks[0].negative.power_out ~ .line_drivers[1].negative_power
    .codecs[0].dac_out[1] ~ .line_drivers[1].input_signal
    .line_drivers[1].output_force ~ .xlr_out[1].signal
    .power.audio_banks[0].positive.power_out ~ .line_drivers[2].positive_power
    .power.audio_banks[0].negative.power_out ~ .line_drivers[2].negative_power
    .codecs[0].dac_out[2] ~ .line_drivers[2].input_signal
    .line_drivers[2].output_force ~ .xlr_out[2].signal
    .power.audio_banks[0].positive.power_out ~ .line_drivers[3].positive_power
    .power.audio_banks[0].negative.power_out ~ .line_drivers[3].negative_power
    .codecs[0].dac_out[3] ~ .line_drivers[3].input_signal
    .line_drivers[3].output_force ~ .xlr_out[3].signal
    .power.audio_banks[0].positive.power_out ~ .line_drivers[4].positive_power
    .power.audio_banks[0].negative.power_out ~ .line_drivers[4].negative_power
    .codecs[0].dac_out[4] ~ .line_drivers[4].input_signal
    .line_drivers[4].output_force ~ .xlr_out[4].signal
    .power.audio_banks[0].positive.power_out ~ .line_drivers[5].positive_power
    .power.audio_banks[0].negative.power_out ~ .line_drivers[5].negative_power
    .codecs[0].dac_out[5] ~ .line_drivers[5].input_signal
    .line_drivers[5].output_force ~ .xlr_out[5].signal
    .power.audio_banks[1].positive.power_out ~ .line_drivers[6].positive_power
    .power.audio_banks[1].negative.power_out ~ .line_drivers[6].negative_power
    .codecs[1].dac_out[0] ~ .line_drivers[6].input_signal
    .line_drivers[6].output_force ~ .ethercon_out[0].signals[0]
    .power.audio_banks[1].positive.power_out ~ .line_drivers[7].positive_power
    .power.audio_banks[1].negative.power_out ~ .line_drivers[7].negative_power
    .codecs[1].dac_out[1] ~ .line_drivers[7].input_signal
    .line_drivers[7].output_force ~ .ethercon_out[0].signals[1]
    .power.audio_banks[1].positive.power_out ~ .line_drivers[8].positive_power
    .power.audio_banks[1].negative.power_out ~ .line_drivers[8].negative_power
    .codecs[1].dac_out[2] ~ .line_drivers[8].input_signal
    .line_drivers[8].output_force ~ .ethercon_out[0].signals[2]
    .power.audio_banks[1].positive.power_out ~ .line_drivers[9].positive_power
    .power.audio_banks[1].negative.power_out ~ .line_drivers[9].negative_power
    .codecs[1].dac_out[3] ~ .line_drivers[9].input_signal
    .line_drivers[9].output_force ~ .ethercon_out[0].signals[3]
    .power.audio_banks[2].positive.power_out ~ .line_drivers[10].positive_power
    .power.audio_banks[2].negative.power_out ~ .line_drivers[10].negative_power
    .codecs[1].dac_out[4] ~ .line_drivers[10].input_signal
    .line_drivers[10].output_force ~ .ethercon_out[1].signals[0]
    .power.audio_banks[2].positive.power_out ~ .line_drivers[11].positive_power
    .power.audio_banks[2].negative.power_out ~ .line_drivers[11].negative_power
    .codecs[1].dac_out[5] ~ .line_drivers[11].input_signal
    .line_drivers[11].output_force ~ .ethercon_out[1].signals[1]
    .power.audio_banks[2].positive.power_out ~ .line_drivers[12].positive_power
    .power.audio_banks[2].negative.power_out ~ .line_drivers[12].negative_power
    .codecs[1].dac_out[6] ~ .line_drivers[12].input_signal
    .line_drivers[12].output_force ~ .ethercon_out[1].signals[2]
    .power.audio_banks[2].positive.power_out ~ .line_drivers[13].positive_power
    .power.audio_banks[2].negative.power_out ~ .line_drivers[13].negative_power
    .codecs[1].dac_out[7] ~ .line_drivers[13].input_signal
    .line_drivers[13].output_force ~ .ethercon_out[1].signals[3]

    # Original three-switch network: two four-port edges plus a CM5 uplink.
    .ports: PANEL::EthernetPorts
    .ports.ethernet[0] ~ .eth_switches[0].ethernets[3]
    .ports.ethernet[1] ~ .eth_switches[0].ethernets[1]
    .ports.ethernet[2] ~ .eth_switches[1].ethernets[3]
    .ports.ethernet[3] ~ .eth_switches[1].ethernets[1]
    .ports.ethernet[4] ~ .eth_switches[0].ethernets[4]
    .ports.ethernet[5] ~ .eth_switches[0].ethernets[2]
    .ports.ethernet[6] ~ .eth_switches[1].ethernets[2]
    .ports.ethernet[7] ~ .eth_switches[1].ethernets[0]
    .cm.ethernet ~ .eth_switches[2].ethernets[4]
    .eth_switches[2].ethernets[3] ~ .eth_switches[0].ethernets[0]
    .eth_switches[2].ethernets[2] ~ .eth_switches[1].ethernets[4]
    .cm.gpios[3] ~ .eth_switches[0].mdc
    .cm.gpios[4] ~ .eth_switches[0].mdio
    .cm.gpios[6] ~ .eth_switches[1].mdc
    .cm.gpios[7] ~ .eth_switches[1].mdio
    .cm.gpios[8] ~ .eth_switches[2].mdc
    .cm.gpios[9] ~ .eth_switches[2].mdio

    .xlr_dmx_in: PANEL::DmxInput
    .xlr_dmx_out: PANEL::DmxOutput
    .cm.uart0 ~ .dmx_phy.uart
    .cm.gpios[5] ~ .dmx_phy.driver_enable
    .cm.gpios[10] ~ .dmx_phy.n_receiver_enable
    .dmx_phy.rs485_bus ~ .xlr_dmx_in.signal ~ .xlr_dmx_out.signal
    .dmx_phy.power.lv ~ .xlr_dmx_in.common ~ .xlr_dmx_out.common

    .debug: PANEL::DebugHeader
    .debug.i2c ~ .cm.i2cs[0]
    .debug.reset ~ .dsp.reset_disable
    .debug.ground ~ .power.power_5v.lv
    .usb: PANEL::UsbDeviceConnector
    .usb.data_p ~ .cm.usb_p
    .usb.data_n ~ .cm.usb_n
    .usb.ground ~ .power.power_5v.lv

    # Panel shields remain separate from circuit common.
    @for(.xlr_in, { .obj.shield ~ power.earth })
    @for(.xlr_out, { .obj.shield ~ power.earth })
    @for(.ethercon_out, { .obj.shield ~ power.earth })
    .xlr_dmx_in.shield ~ .xlr_dmx_out.shield ~ .ports.shield ~ .usb.shield ~ .power.earth

    # Net names for the interesting nets
    @trait(_, .power.power_5v.hv): ELEC::has_net_name { .name &= "P5V" }
    @trait(_, .power.power_5v.lv): ELEC::has_net_name { .name &= "GND" }
    @trait(_, .power.power_3v3d.hv): ELEC::has_net_name { .name &= "P3V3_DIG" }
    @trait(_, .power.power_3v3a.hv): ELEC::has_net_name { .name &= "P3V3_ANA" }
    @trait(_, .dmx_phy.rs485_bus.p.line): ELEC::has_net_name { .name &= "DMX_P" }
    @trait(_, .dmx_phy.rs485_bus.n.line): ELEC::has_net_name { .name &= "DMX_N" }
}
