.ELEC: @STD::Import { .project &= "electronics"; .org &= "atopile" }
.PARTS := .ELEC::PARTS
.VLDO: @STD::Import { .uri &= "vendor/ti-tlv75901/ti-tlv75901.ato" }
.BUCK: @STD::Import { .uri &= "vendor/ti-tpsm863257/ti-tpsm863257.ato" }
.ISOLATED: @STD::Import { .uri &= "vendor/ylptec-b0524s/ylptec-b0524s.ato" }
.POST: @STD::Import { .uri &= "vendor/ti-tps7a47/ti-tps7a47.ato" }
.INPUT: @STD::Import { .org &= "jlc"; .project &= "C430456"; .version &= "0.1.0" }

.Isolated18VRail: @type {
    /// One floating 18 V rail: 5 V -> isolated 24 V -> low-noise 18 V.
    .converter: ISOLATED::B0524S
    .post_regulator: POST::TPS7A4700_18V
    .converter.power_out ~ .post_regulator.power_in
    .power_in := .converter.power_in
    .power_out := .post_regulator.power_out
    # 83 mA converter limit includes its preload and the LDO's supply current.
    # Reserve at most 60 mA for the external load on each 18 V rail.
}

.AudioPowerBank: @type {
    /// Independent +/-18 V pair, 60 mA available per rail.
    .positive: Isolated18VRail
    .negative: Isolated18VRail
    .power_in := .positive.power_in
    .power_in ~ .negative.power_in
    .positive.power_out.lv ~ .power_in.lv
    .negative.power_out.hv ~ .power_in.lv
}

.PowerSupply: @type {
    /// Regulated external 5 V input; separate digital/analog 3.3 V and +/-18 V.
    .power_dc_in: ELEC::ElectricPower { .voltage &= 5V +/- 5% }
    .power_5v := .power_dc_in
    .earth: ELEC::Interfaces::Electrical
    .input_connector: INPUT::DORABO_DB2ERC_5_08_2P_BK
    .input_connector.'1' ~ .power_dc_in.hv
    .input_connector.'2' ~ .power_dc_in.lv

    .buck_3v3_digital: BUCK::TPSM863257
    .ldo_3v3_analog: VLDO::TI_TLV75901
    .audio_banks: [3]AudioPowerBank
    @for(.audio_banks, { power_5v ~ .obj.power_in })

    .power_3v3d := .buck_3v3_digital.power_out
    .power_3v3a := .ldo_3v3_analog.power_out
    .power_3v3d.voltage &= 3.3V +/- 3%
    .power_3v3a.voltage &= 3.3V +/- 3%

    .power_5v ~ .buck_3v3_digital.power_in
    .power_5v ~ .ldo_3v3_analog.power_in
    .bulk_cap_5v: ELEC::Capacitor {
        .capacitance &= 22uF +/- 20%
        .max_voltage >= 16V
        @trait(_): PARTS::has_package_requirements { .size &= "1206" }
    }
    .power_5v.hv ~> .bulk_cap_5v ~> .power_5v.lv
}
