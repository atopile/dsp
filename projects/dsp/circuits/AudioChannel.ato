.ELEC: @STD::Import { .org &= "atopile"; .project &= "electronics" }
.C12744: @STD::Import { .org &= "jlc"; .project &= "C12744"; .version &= "0.1.0" }
.C45783: @STD::Import { .org &= "jlc"; .project &= "C45783"; .version &= "0.1.0" }
.C52923: @STD::Import { .org &= "jlc"; .project &= "C52923"; .version &= "0.1.0" }
.C544663: @STD::Import { .org &= "jlc"; .project &= "C544663"; .version &= "0.1.0" }
.C96446: @STD::Import { .org &= "jlc"; .project &= "C96446"; .version &= "0.1.0" }

.AudioChannel: @type {
    /// Original DSP circuit, with its component and pad connectivity preserved.
    .clamp_diodes_0: C12744::LRC_LBAT54HT1G
    .clamp_diodes_1: C12744::LRC_LBAT54HT1G
    .clamp_diodes_2: C12744::LRC_LBAT54HT1G
    .clamp_diodes_3: C12744::LRC_LBAT54HT1G
    .decoupling_capacitors_0: C45783::Samsung_Electro_Mechanics_CL21A226MAQNNNE
    .decoupling_capacitors_1: C45783::Samsung_Electro_Mechanics_CL21A226MAQNNNE
    .ic: C544663::Texas_Instruments_DRV135UA_2K5
    .input_decoupling_capacitor: C96446::Samsung_Electro_Mechanics_CL10A106MA8NRNC
    .line_driver_ic_negative_decoupling_capacitor: C52923::Samsung_Electro_Mechanics_CL05A105KA5NQNC
    .line_driver_ic_positive_decoupling_capacitor: C52923::Samsung_Electro_Mechanics_CL05A105KA5NQNC
    .sense_decoupling_capacitors_0: C96446::Samsung_Electro_Mechanics_CL10A106MA8NRNC
    .sense_decoupling_capacitors_1: C96446::Samsung_Electro_Mechanics_CL10A106MA8NRNC

    .ground: ELEC::Interfaces::Electrical
    .ground ~ .ic.'3' ~ .line_driver_ic_negative_decoupling_capacitor.'1' ~ .line_driver_ic_positive_decoupling_capacitor.'2'
    .negative_supply: ELEC::Interfaces::Electrical
    .negative_supply ~ .clamp_diodes_1.'2' ~ .clamp_diodes_3.'2' ~ .ic.'5' ~ .line_driver_ic_negative_decoupling_capacitor.'2'
    .net_decoupling_capacitors_0_2: ELEC::Interfaces::Electrical
    .net_decoupling_capacitors_0_2 ~ .decoupling_capacitors_0.'2'
    .net_decoupling_capacitors_1_2: ELEC::Interfaces::Electrical
    .net_decoupling_capacitors_1_2 ~ .decoupling_capacitors_1.'2'
    .net_ic_SENSEneg: ELEC::Interfaces::Electrical
    .net_ic_SENSEneg ~ .ic.'2' ~ .sense_decoupling_capacitors_1.'1'
    .net_ic_SENSEpos: ELEC::Interfaces::Electrical
    .net_ic_SENSEpos ~ .ic.'7' ~ .sense_decoupling_capacitors_0.'1'
    .net_ic_VIN: ELEC::Interfaces::Electrical
    .net_ic_VIN ~ .ic.'4' ~ .input_decoupling_capacitor.'2'
    .net_ic_VOneg: ELEC::Interfaces::Electrical
    .net_ic_VOneg ~ .clamp_diodes_2.'2' ~ .clamp_diodes_3.'1' ~ .decoupling_capacitors_1.'1' ~ .ic.'1' ~ .sense_decoupling_capacitors_1.'2'
    .net_ic_VOpos: ELEC::Interfaces::Electrical
    .net_ic_VOpos ~ .clamp_diodes_0.'2' ~ .clamp_diodes_1.'1' ~ .decoupling_capacitors_0.'1' ~ .ic.'8' ~ .sense_decoupling_capacitors_0.'2'
    .net_input_decoupling_capacitor_1: ELEC::Interfaces::Electrical
    .net_input_decoupling_capacitor_1 ~ .input_decoupling_capacitor.'1'
    .positive_supply: ELEC::Interfaces::Electrical
    .positive_supply ~ .clamp_diodes_0.'1' ~ .clamp_diodes_2.'1' ~ .ic.'6' ~ .line_driver_ic_positive_decoupling_capacitor.'1'
}
