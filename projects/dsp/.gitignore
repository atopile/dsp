# Build-generated state — a fixture consumer rebuilds these locally.
# (layouts/ IS checked in: it carries the upstream board's preserved
# placement and routing, relinked to the v2 instance paths. The baked
# 3d_models are regenerated from part bundles on every sync.)
.ato/
build/
manufacturing/
layouts/default/default.pcb.hl/3d_models/

# Parts the picker installs for generic R/C picks during a build (checksummed
# archives, re-downloaded per build). Only the hand-referenced IC/support
# parts are fixture sources; picked ones must stay unmodified or absent.
parts/FH_*/
parts/FOJAN_*/
parts/HRE_*/
parts/KNSCHA_*/
parts/KOA_*/
parts/Murata_*/
parts/RESI_*/
parts/Samsung_*/
parts/UNI_ROYAL_*/
parts/YAGEO_*/
